# ── new-frontend env config ───────────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and adjust per environment. Vite only exposes
# vars prefixed with VITE_ to the client. Real .env files are gitignored.

# ── ai-router (FastAPI intelligence engine) ────────────────────────────────
# Base URL for the ai-router service. Dashboards (GSIS, incubation, hackathon,
# training, etc.) call this via src/lib/api/config.ts. Read by API_BASE_URL.
# Deployed: https://techit-api-u1ek.onrender.com   Local dev: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000

# When "1", network failures throw instead of falling back to bundled mock data.
# Leave unset (or != "1") so dashboards still render when the backend is down.
# Production must set VITE_API_STRICT=1. Local/demo fallback is opt-in only.
VITE_API_STRICT=
VITE_API_FALLBACK=1

# ── Node auth/app backend ──────────────────────────────────────────────────
# Base URL for the Node.js backend that handles auth (/auth/*) and the user
# profile (/users/me). Read by src/contexts/AuthContext.tsx.
# Deployed: https://techit-backend.onrender.com/api   Local dev: http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Base URL for the Plugins-MCP mount on the Node backend.
# Deployed: https://techit-backend.onrender.com/api/mcp   Local dev: http://localhost:3000/api/mcp
VITE_TECHIT_API=http://localhost:3000/api/mcp

# ── Go messaging service (WS1 — optional, only if running messaging locally) ─
# REST + WebSocket endpoints for the real-time messaging/feed backend.
VITE_MESSAGING_BASE_URL=http://localhost:8080
VITE_MESSAGING_WS_URL=ws://localhost:8080/ws
VITE_MESSAGING_TIMEOUT_MS=15000

# ── post-deploy smoke only; not exposed to the browser build unless prefixed ─
FRONTEND_URL=http://localhost:5173
SMOKE_TIMEOUT_MS=10000
